# Copy to .env locally. Never commit .env or paste credentials into chat.
GEMINI_API_KEY=
# Generative roles are selected and persisted in Settings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Tiger Data PostgreSQL URL; a local pgvector database is also supported.
DATABASE_URL=postgresql://prompt_enhance:prompt_enhance@127.0.0.1:54329/prompt_enhance

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_MODEL_VERSION=

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000
MCP_PORT=8001
